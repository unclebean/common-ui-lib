# Figma API Credentials (Private - DO NOT COMMIT TO VERSION CONTROL)

FIGMA_PERSONAL_ACCESS_TOKEN=your_figma_personal_access_token
FIGMA_FILE_KEY=your_figma_file_key

# =====================================================================
# Storybook AI Agent & Mockup Studio - Server Configuration
# =====================================================================

# Default AI Provider ("gemini" or "ollama")
# If GEMINI_API_KEY is provided, defaults to "gemini".
STORYBOOK_AI_PROVIDER=gemini

# Default AI Model across providers (or configure individually below)
STORYBOOK_AI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------
# Google Gemini Configuration (Recommended for Cloud Server Deployment)
# ---------------------------------------------------------------------
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Specific Gemini Model ("gemini-3.6-flash", "gemini-2.0-flash", "gemini-1.5-pro")
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------
# Local / Remote Ollama Configuration
# ---------------------------------------------------------------------
# Ollama Server Endpoint URL
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Specific Ollama Model ("llama3.2:latest", "llama3:latest", "mistral", etc.)
OLLAMA_MODEL=llama3.2:latest
